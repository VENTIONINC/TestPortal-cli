{
  "name": "@vention-test-portal/test-portal-integration-cli",
  "version": "1.1.2",
  "description": "A lightweight Node.js CLI utility that converts test reports from popular frameworks to unified format",
  "main": "dist/index.js",
  "bin": {
    "test-portal-cli": "dist/cli.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "ts-node src/cli.ts",
    "headers:add": "node scripts/add-license-headers.js",
    "licenses:check": "node scripts/check-licenses.js",
    "new:file": "node scripts/new-file.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "test",
    "testing",
    "playwright",
    "junit",
    "cli",
    "converter",
    "test-results",
    "unified"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vention-Test-Portal/test-portal-integration-cli.git"
  },
  "author": "iharMikailau",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/form-data": "2.2.1",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.1",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.5.1",
    "jest": "29.7.0",
    "prettier": "3.6.1",
    "rimraf": "5.0.10",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@types/xml2js": "0.4.14",
    "axios": "1.16.0",
    "commander": "11.1.0",
    "dotenv": "16.6.1",
    "fast-xml-parser": "5.7.3",
    "form-data": "4.0.4",
    "xml2js": "0.6.2",
    "zod": "3.25.67"
  }
}
