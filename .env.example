# Test Portal URL
# Default webhook URL for sending test reports
# Can be overridden with --webhook CLI option
TEST_PORTAL_URL=https://your-portal.com/api/v2/upload-ctrf-report-api-key

# Test Portal API Key
# Used for authenticating webhook requests to the Test Portal API
# This will be sent as the X-API-Key header in all webhook requests
TEST_PORTAL_API_KEY=your-api-key-here

# Execution type for uploaded runs (e.g. nightly, release, ondemand)
# Written to CTRF results.environment.executionType
EXECUTION_TYPE=release

# Test environment label (e.g. develop, staging, production)
# Written to CTRF results.environment.testEnvironment
# Defaults to "ci" when running in a detected CI system
TEST_ENVIRONMENT=develop
